# Required
NEWSLETTER_JSON_URL=https://blog.mitcdh.au/newsletter.json
LISTMONK_BASE_URL=https://listmonk.example.com
LISTMONK_API_USERNAME=hugo-newsletter-sync
LISTMONK_API_TOKEN=replace-with-api-token
LISTMONK_LIST_IDS=1

# Feed field selectors (exact top-level keys)
CAMPAIGN_NAME_FIELD=key
CAMPAIGN_SUBJECT_FIELD=title
CAMPAIGN_CONTENT_FIELD=html

# Defaults applied only when a campaign is first created
LISTMONK_CONTENT_TYPE=html
LISTMONK_CAMPAIGN_TYPE=regular
LISTMONK_MESSENGER=email
# LISTMONK_TEMPLATE_ID=1
# LISTMONK_FROM_EMAIL=Newsletter <newsletter@example.com>
# LISTMONK_CAMPAIGN_TAGS=hugo,newsletter

# Process and HTTP behavior
POLL_INTERVAL_SECONDS=3600
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
LOG_LEVEL=INFO
RUN_ONCE=false

